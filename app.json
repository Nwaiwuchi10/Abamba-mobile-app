{
  "expo": {
    "name": "Abamba",
    "slug": "Abamba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "abamba",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abamba.app",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Abamba needs camera access so you can take and upload photos for products, profile, and verification documents.",
        "NSPhotoLibraryUsageDescription": "Abamba needs photo library access so you can select and upload images for products, profile, and documents."
      }
    },
    "android": {
      "package": "com.abamba.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logos/splash-logo-safe.png",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b03d9088-6e53-42d8-9bd6-379b6f98a314"
      }
    },
    "owner": "puyol"
  }
}
